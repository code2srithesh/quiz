{
    "name": "quizforge-ai",
    "version": "1.0.0",
    "description": "Premium AI-powered PDF to Quiz generation platform",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "next lint",
        "type-check": "tsc --noEmit",
